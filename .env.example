# --- Bolo reminder copilot ---

# Sarvam AI key (sign up at https://indus.sarvam.ai) — used for translation
# (mayura:v1, modern-colloquial), Bulbul text-to-speech, and (optionally)
# LLM-drafted message templates via Token Factory's OpenAI-compatible /v2
# chat endpoint (Bearer auth accepted).
SARVAM_API_KEY=

# Bulbul model. bulbul:v4-flash is the project default, with per-language
# persona voices (see sarvam_service.V4_SPEAKERS); Malayalam/Odia fall back
# to bulbul:v3 automatically.
# SARVAM_TTS_MODEL=bulbul:v4-flash
# SARVAM_TTS_SPEAKER=shubh

# Model used to draft message templates when add_reminder gets none
# (Token Factory chat endpoint, same SARVAM_API_KEY).
# SARVAM_LLM_MODEL=sarvam-105b
# Reasoning models burn max_tokens on thinking; drafting switches it off.
# Set SARVAM_LLM_REASONING= (blank) to omit the parameter entirely for
# models that do not accept it (e.g. glm5.3, kimi).
# SARVAM_LLM_REASONING=none

# Retry ladder: minutes to wait for a press-1/press-2 reply before re-attempting
# a dispatched reminder, and how many total attempts are allowed.
# BOLO_RETRY_AFTER_MINUTES=360
# BOLO_MAX_DISPATCH_ATTEMPTS=2

# Auth token for POST /notifier/webhook/response/ — the endpoint real channels
# (IVR DTMF, WhatsApp) call digits into. Until this is set the webhook refuses
# everything with 403; the demo respond page does not need it.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# BOLO_WEBHOOK_TOKEN=

# Django
DEBUG=True

# --- Optional: WhatsApp delivery (production path, not needed for the demo) ---
# Twilio WhatsApp sandbox credentials, or Meta WhatsApp Cloud API. Wired in
# notifier/services/delivery.py when you enable real delivery.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# or Meta Cloud API:
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=

# Synapse --local build (Custom mode) — one Sarvam key covers this too, via
# Token Factory's OpenAI-compatible /v2 chat endpoint (Bearer auth accepted):
#   synapse model set custom --base-url https://api.sarvam.ai/v2 --model sarvam-105b --global
#   set SYNAPSE_LLM_API_KEY=<same key as SARVAM_API_KEY>
# Or bring a direct provider key instead, e.g. ANTHROPIC_API_KEY=sk-ant-...
