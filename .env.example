# --- Bolo reminder copilot ---

# Sarvam AI key (sign up at https://indus.sarvam.ai) — used for translation
# (mayura:v1, modern-colloquial) and Bulbul text-to-speech.
SARVAM_API_KEY=

# Optional Bulbul overrides. Defaults: bulbul:v3 with the 'shubh' voice.
# v4-flash uses persona speaker ids, e.g. SARVAM_TTS_SPEAKER=aparna_hi_customer
# SARVAM_TTS_MODEL=bulbul:v4-flash
# SARVAM_TTS_SPEAKER=shubh

# Django
DEBUG=True

# Synapse --local build (Custom mode) — one Sarvam key covers this too, via
# Token Factory's OpenAI-compatible /v2 chat endpoint (Bearer auth accepted):
#   synapse model set custom --base-url https://api.sarvam.ai/v2 --model sarvam-105b --global
#   set SYNAPSE_LLM_API_KEY=<same key as SARVAM_API_KEY>
# Or bring a direct provider key instead, e.g. ANTHROPIC_API_KEY=sk-ant-...
